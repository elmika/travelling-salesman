        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"points\": [\n    {\"x\": 37, \"y\": 95},\n    {\"x\": 73, \"y\": 59},\n    {\"x\": 15, \"y\": 15},\n    {\"x\": 5,  \"y\": 86},\n    {\"x\": 60, \"y\": 70},\n    {\"x\": 2,  \"y\": 96},\n    {\"x\": 83, \"y\": 21},\n    {\"x\": 18, \"y\": 18},\n    {\"x\": 30, \"y\": 52},\n    {\"x\": 43, \"y\": 29}\n  ],\n  \"solution\": {\n    \"route\": [1, 6, 4, 9, 5, 2, 7, 10, 3, 8],\n    \"totalDistance\": 298.17\n  },\n  \"strategy\": \"2opt\"\n}",
